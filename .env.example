# Šablona proměnných prostředí. Zkopírujte do .env (je v .gitignore) a doplňte heslo.
# Repozitář je veřejný: skutečné heslo sem nikdy nezapisujte.
#
# Heslo role neondb_owner najdete v Neon Console → projekt databaze-investoru
# (ID old-sun-07993505) → Connect. Stejné proměnné je potřeba nastavit i na Vercelu
# (Project → Settings → Environment Variables), nebo je nastaví integrace Vercel–Neon.

# Produkční adresa aplikace (Vercel), jen pro informaci – kód ji nepoužívá.
APP_URL=https://databaze-investoru.vercel.app

# Neon, větev main – pooled připojení (API, Vercel Functions)
DATABASE_URL=postgresql://neondb_owner:<HESLO>@ep-weathered-bread-b9lsnc9i-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon, větev main – přímé připojení (migrace a seed: npm run db:setup)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<HESLO>@ep-weathered-bread-b9lsnc9i.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
